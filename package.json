{
  "name": "lumiere",
  "version": "1.1.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "build:dev": "npx drizzle-kit generate && npx expo prebuild -p android && npx expo run:android",
    "build:prod": "npx drizzle-kit generate &&  npx expo prebuild -p android && npx expo run:android --variant release",
    "build:dev:clean": "npx drizzle-kit generate && npx expo prebuild -p android --clean && npx expo run:android",
    "build:prod:clean": "npx drizzle-kit generate && npx expo prebuild -p android --clean && npx expo run:android --variant release",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^0.9.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "2.8.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.83.1",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-persist-client": "^5.84.1",
    "add": "^2.0.6",
    "babel-plugin-inline-import": "^3.0.0",
    "cheerio": "npm:react-native-cheerio@1.0.0-rc.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.2",
    "expo": "^54.0.35",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "htmlparser2": "^10.0.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react-native": "^0.525.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-bottom-tabs": "^0.9.2",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.1.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@dev-plugins/react-query": "^0.4.0",
    "@types/cheerio": "^1.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@dev-plugins/react-query"
        ]
      }
    }
  }
}
